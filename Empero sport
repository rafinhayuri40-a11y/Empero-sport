<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Empero Sport</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:'Roboto', sans-serif; }
body { background-color:#0d0d0d; color:#fff; }
header { background-color:#1a1a1a; padding:15px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; }
header h1 { color:#0099ff; display:flex; align-items:center; gap:10px; }
header h1::before { content:'👑'; }
nav a { color:#fff; margin-left:20px; text-decoration:none; font-weight:500; transition:color 0.3s; }
nav a:hover { color:#0099ff; }
.search-bar { flex:1; margin:10px 20px; display:flex; }
.search-bar input { flex:1; padding:8px 12px; border-radius:5px 0 0 5px; border:none; outline:none; }
.search-bar button { padding:8px 15px; border:none; background-color:#0099ff; color:#fff; border-radius:0 5px 5px 0; cursor:pointer; }

.banner { width:100%; height:250px; background:url('https://images.unsplash.com/photo-1599058917216-04f635db8d09') center/cover no-repeat; display:flex; align-items:center; justify-content:center; color:#fff; font-size:2em; font-weight:bold; text-shadow:2px 2px 5px #000; }

.filters { display:flex; justify-content:center; margin:20px 0; gap:15px; flex-wrap:wrap; }
.filters button { padding:8px 15px; background-color:#0099ff; color:#fff; border:none; border-radius:5px; cursor:pointer; transition:background 0.3s; }
.filters button:hover { background-color:#007acc; }

.products { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; padding:0 20px 30px; }
.product-card { background-color:#1a1a1a; border-radius:10px; overflow:hidden; transition:transform 0.3s; cursor:pointer; }
.product-card:hover { transform:scale(1.05); }
.product-card img { width:100%; height:200px; object-fit:cover; }
.product-info { padding:15px; }
.product-info h3 { color:#0099ff; margin-bottom:10px; }
.product-info p { margin-bottom:10px; font-size:0.9em; }
.product-info span { font-weight:bold; }
.buy-btn { display:inline-block; padding:8px 15px; background-color:#0099ff; color:#fff; text-decoration:none; border-radius:5px; transition:background 0.3s; }
.buy-btn:hover { background-color:#007acc; }

.cart { position:fixed; top:20px; right:20px; background-color:#1a1a1a; padding:15px; border-radius:10px; width:300px; max-height:80vh; overflow-y:auto; box-shadow:0 0 10px #000; }
.cart h2 { margin-bottom:10px; color:#0099ff; }
.cart-item { display:flex; justify-content:space-between; margin-bottom:10px; }
.cart-item span { font-weight:bold; }
.checkout-btn { width:100%; padding:10px; background-color:#0099ff; color:#fff; border:none; border-radius:5px; cursor:pointer; margin-top:10px; transition: background 0.3s; }
.checkout-btn:hover { background-color:#007acc; }

footer { background-color:#1a1a1a; padding:20px; text-align:center; color:#888; margin-top:40px; }

/* Chat avançado flutuante */
#chat-container { position:fixed; bottom:20px; right:20px; width:300px; max-height:400px; background-color:#1a1a1a; border-radius:10px; display:flex; flex-direction:column; box-shadow:0 0 10px #000; transition:all 0.3s; }
#chat-header { background-color:#0099ff; padding:10px; border-radius:10px 10px 0 0; cursor:pointer; display:flex; justify-content:space-between; align-items:center; }
#chat-header h3 { margin:0; font-size:1em; color:#fff; }
#chat-toggle { cursor:pointer; font-weight:bold; }
#chat-messages { flex:1; padding:10px; overflow-y:auto; }
.message { margin-bottom:10px; padding:5px 10px; border-radius:10px; max-width:80%; word-wrap:break-word; }
.message.user { text-align:right; background-color:#00ff9940; margin-left:auto; }
.message.bot { text-align:left; background-color:#fff2; margin-right:auto; }
#chat-input { display:flex; border-top:1px solid #333; }
#chat-input input { flex:1; padding:8px; border:none; outline:none; border-radius:0 0 0 10px; }
#chat-input button { padding:8px; border:none; background-color:#0099ff; color:#fff; cursor:pointer; border-radius:0 0 10px 0; }
#chat-input button:hover { background-color:#007acc; }

@media(max-width:768px){ header { flex-direction:column; gap:10px; } .search-bar { width:100%; margin:0; } .cart { width:90%; right:5%; } #chat-container { width:90%; right:5%; bottom:10px; } }
</style>
</head>
<body>
<header>
    <h1>Empero Sport</h1>
    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="Buscar produtos...">
        <button onclick="searchProduct()">🔍</button>
    </div>
    <nav>
        <a href="#">Início</a>
        <a href="#">Produtos</a>
        <a href="#">Carrinho</a>
        <a href="#">Contato</a>
    </nav>
</header>

<div class="banner">Bem-vindo ao Empero Sport!</div>

<div class="filters">
    <button onclick="filterCategory('todos')">Todos</button>
    <button onclick="filterCategory('chuteira')">Chuteiras</button>
    <button onclick="filterCategory('meia')">Meias</button>
    <button onclick="filterCategory('camisa')">Camisas</button>
    <button onclick="filterCategory('short')">Shorts</button>
</div>

<section class="products" id="productContainer"></section>

<div class="cart" id="cart">
    <h2>Carrinho</h2>
    <div id="cartItems"></div>
    <button class="checkout-btn" onclick="checkout()">Finalizar Compra</button>
</div>

<!-- Chat avançado flutuante -->
<div id="chat-container">
    <div id="chat-header">
        <h3>Chat com a Loja</h3>
        <span id="chat-toggle">−</span>
    </div>
    <div id="chat-messages"></div>
    <div id="chat-input">
        <input type="text" id="chatMessage" placeholder="Digite sua mensagem...">
        <button onclick="sendMessage()">Enviar</button>
    </div>
</div>

<footer>
    &copy; 2025 Empero Sport - Todos os direitos reservados.
</footer>

<script>
// Produtos
const products = [
    {id:1, name:'Chuteira Nike', price:349.90, category:'chuteira', desc:'Confortável e resistente para jogos intensos.', img:'https://images.unsplash.com/photo-1605902711622-cfb43c4436b6'},
    {id:2, name:'Meias Esportivas', price:29.90, category:'meia', desc:'Alta performance e secagem rápida.', img:'https://images.unsplash.com/photo-1611599537102-4d1d7a4c7314'},
    {id:3, name:'Camisa de Futebol', price:149.90, category:'camisa', desc:'Material respirável, ideal para treinos e jogos.', img:'https://images.unsplash.com/photo-1606813900424-95fef7e1f7f1'},
    {id:4, name:'Short Esportivo', price:79.90, category:'short', desc:'Leve e confortável, perfeito para jogar futebol.', img:'https://images.unsplash.com/photo-1605902711621-9a9d7b3b9d2a'},
];

let cart = [];

function displayProducts(items){
    const container = document.getElementById('productContainer');
    container.innerHTML = '';
    items.forEach(product => {
        const card = document.createElement('div');
        card.className = 'product-card';
        card.innerHTML = `
            <img src="${product.img}" alt="${product.name}">
            <div class="product-info">
                <h3>${product.name}</h3>
                <p>${product.desc}</p>
                <span>R$ ${product.price.toFixed(2)}</span><br><br>
                <a class="buy-btn" onclick="addToCart(${product.id})">Comprar</a>
                <a class="buy-btn" style="margin-top:5px;" onclick="sendProductLink(${product.id})">📩 Enviar no Chat</a>
            </div>
        `;
        container.appendChild(card);
    });
}

function filterCategory(cat){
    if(cat === 'todos') displayProducts(products);
    else displayProducts(products.filter(p => p.category === cat));
}

function searchProduct(){
    const query = document.getElementById('searchInput').value.toLowerCase();
    const filtered = products.filter(p => p.name.toLowerCase().includes(query));
    displayProducts(filtered);
}

function addToCart(id){
    const product = products.find(p => p.id === id);
    const existing = cart.find(item => item.id === id);
    if(existing) existing.qty +=1;
    else cart.push({...product, qty:1});
    updateCart();
}

function updateCart(){
    const cartDiv = document.getElementById('cartItems');
    cartDiv.innerHTML = '';
    cart.forEach(item => {
        const div = document.createElement('div');
        div.className = 'cart-item';
        div.innerHTML = `${item.name} x${item.qty} <span>R$ ${(item.price*item.qty).toFixed(2)}</span>`;
        cartDiv.appendChild(div);
    });
}

function checkout(){
    if(cart.length === 0) { alert('Carrinho vazio!'); return; }
    let total = cart.reduce((sum, item) => sum + item.price*item.qty, 0);
    alert(`Compra finalizada! Total: R$ ${total.toFixed(2)}`);
    cart = [];
    updateCart();
}

// Inicial
displayProducts(products);

// Chat avançado
const chatContainer = document.getElementById('chat-container');
const chatToggle = document.getElementById('chat-toggle');
chatToggle.onclick = () => {
    const msgs = document.getElementById('chat-messages');
    const inputDiv = document.getElementById('chat-input');
    if(msgs.style.display !== 'none'){
        msgs.style.display = 'none';
        inputDiv.style.display = 'none';
        chatToggle.textContent = '+';
    } else {
        msgs.style.display = 'block';
        inputDiv.style.display = 'flex';
        chatToggle.textContent = '−';
    }
};

function sendMessage(){
    const input = document.getElementById('chatMessage');
    const msg = input.value.trim();
    if(msg === '') return;
    addChatMessage('user', msg);
    input.value = '';
    setTimeout(()=>{ addChatMessage('bot', generateBotReply(msg)); },500);
}

function addChatMessage(type, message){
    const chatMessages = document.getElementById('chat-messages');
    const div = document.createElement('div');
    div.className = `message ${type}`;
    div.innerHTML = message;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

function generateBotReply(msg){
    msg = msg.toLowerCase();
    if(msg.includes('chuteira')) return 'Temos várias chuteiras disponíveis, confira no catálogo!';
    if(msg.includes('meia')) return 'Nossas meias são de alta performance!';
    if(msg.includes('camisa')) return 'As camisas de futebol estão em promoção!';
    if(msg.includes('short')) return 'Shorts confortáveis para treinos disponíveis!';
    return 'Olá! Como posso ajudá-lo com nossos produtos?';
}

// Enviar produto direto no chat
function sendProductLink(id){
    const product = products.find(p => p.id === id);
    const message = `<b>${product.name}</b><br>Preço: R$ ${product.price.toFixed(2)}<br><a href="#" onclick="alert('Produto selecionado!')">Ver Produto</a>`;
    addChatMessage('user', message);
    setTimeout(()=>{ addChatMessage('bot', 'Produto recebido! Posso ajudá-lo com mais alguma coisa?'); },500);
}
</script>
</body>
</html>
